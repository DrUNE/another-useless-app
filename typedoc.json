{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/*", "apps/*", "tools/*", "tests/e2e"],
  "exclude": ["packages/config", "tools/api-docs"],
  "packageOptions": {
    "entryPoints": ["src/**/*.{ts,tsx}"]
  },
  "out": "target/docs",
  "name": "another-useless-app API",
  "includeVersion": true,
  "readme": "docs/api-home.md",
  "excludePrivate": true,
  "excludeInternal": true
}
